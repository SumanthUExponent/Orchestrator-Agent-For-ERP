#!/usr/bin/env bash
# jarvisctl — inspect and control the voice layer.
#
#   status            which sessions are live, how long, which are blocked
#   doctor            verify the install: scripts, hooks, voice, daemon count
#   test              walk every alert type, chime and speech, as it really fires
#   chimes            audition every motif back to back, and the four session pitches
#   demo              narrated simulation of four parallel sessions, end to end
#   report            speak where every session stands right now
#   log [n]           the last n announcements
#   mute <minutes> / unmute
#   reset             clear all state (orphan daemons stand down on their own)
#   voices            list installed voices; --setup opens the free high-quality downloads

J="$HOME/.claude/jarvis"; S="$J/state"
[ -f "$J/config.sh" ] && . "$J/config.sh"
[ -f "$J/platform.sh" ] && . "$J/platform.sh"
mkdir -p "$S/active" "$S/start" "$S/pending" "$S/subs" "$J/queue" 2>/dev/null
now=$(date +%s)
SET="$HOME/.claude/settings.json"

# Ask the LOCK, not `ps`. The lock is what enforces the one-daemon invariant, so it
# is the authoritative answer — and `ps -eo args | grep speaker.sh` is not: it also
# matches any other process whose command line happens to contain the pattern,
# including the very shell pipeline asking the question. That reported two daemons
# on a machine running one.
running() {
  local p; p=$(cat "$J/run/lock/pid" 2>/dev/null)
  [ -n "$p" ] && kill -0 "$p" 2>/dev/null && { echo "$p"; return 0; }
  return 1
}
# The invariant is not "one daemon has ever started" — the ledger spans every
# generation, so on a machine that has been up for a week that number means nothing.
# It is "two were never alive AT THE SAME TIME". Replaying the ledger as a running
# count answers exactly that, and it stays true across restarts.
births() { local n; n=$(grep -c ' start$' "$J/run/daemons.log" 2>/dev/null); echo "${n:-0}"; }
max_concurrent() {
  awk '$3=="start"{c++} $3=="exit"{c--} c>m{m=c} END{print m+0}' "$J/run/daemons.log" 2>/dev/null || echo 0
}

# Neither obvious test works: `say -v X -o /dev/null` fails with -241 for EVERY voice,
# and `say -v X -o file.aiff` SUCCEEDS for one that does not exist, because say falls
# back to the default. So an exit code can never validate a voice name.
# Enumeration lives in platform.sh — see the note there on why an exit code cannot
# validate a voice name.
voice_exists() { jv_voice_exists "$1"; }

case "${1:-status}" in
  status)
    if [ -f "$S/muted" ] && [ "$(cat "$S/muted")" -gt "$now" ] 2>/dev/null; then
      echo "MUTED for another $(( ($(cat "$S/muted") - now) / 60 + 1 )) min"
    fi
    n=$(ls "$S/active" 2>/dev/null | wc -l | tr -d ' ')
    echo "Active sessions: $n"
    for f in "$S"/active/*; do
      [ -e "$f" ] || continue
      k=$(basename "$f"); IFS='|' read -r nm ord < "$f"
      st=$(cat "$S/start/$k" 2>/dev/null)
      if [ -n "$st" ]; then el="working $(( (now-st)/60 ))m$(( (now-st)%60 ))s"; else el="idle"; fi
      sb=$(cat "$S/subs/$k" 2>/dev/null); [ -n "$sb" ] && [ "$sb" != "0" ] && el="$el  ${sb} specialist(s)"
      [ -e "$S/pending/$k" ] && el="$el  ** BLOCKED ON APPROVAL **"
      printf '  [%s] %-24s %s\n' "${ord:-?}" "$nm" "$el"
    done
    q=0; for g in "$J"/queue/[0-9]*; do [ -e "$g" ] && q=$(( q + 1 )); done
    echo "Queued announcements: $q"
    if p=$(running); then echo "Speaker: running (pid $p)"
    else echo "Speaker: idle — it starts on demand and exits after ~2 min quiet"; fi
    ;;

  doctor)
    fail=0; advice=0
    # A separate severity, deliberately. "The voice sounds stock" is the most important
    # thing a new user can act on, but it is not a broken install — the layer works
    # exactly as designed. Making it a failure would mean `doctor` exits non-zero on a
    # correct install, and an exit code that cries wolf gets ignored.
    adv() { echo "  ADVICE  $1"; advice=$((advice+1)); }
    ck() { if [ "$1" = 0 ]; then echo "  ok    $2"; else echo "  FAIL  $2"; fail=$((fail+1)); fi; }
    # Capture the status rather than reading $? after a bare condition: $? there refers
    # to the condition, and anything between the two overwrites it silently.
    ckt() { local lbl="$1"; shift; if "$@" >/dev/null 2>&1; then ck 0 "$lbl"; else ck 1 "$lbl"; fi; }
    echo "JARVIS DOCTOR"
    for f in jarvis.sh speaker.sh config.sh; do
      ckt "$f present" test -f "$J/$f"
    done
    for f in jarvis.sh speaker.sh; do
      ckt "$f executable" test -x "$J/$f"
      ckt "$f parses" bash -n "$J/$f"
    done
    if [ -f "$SET" ]; then
      ckt "settings.json is valid JSON" node -e 'JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"))' "$SET"
      hooked=$(grep -c 'jarvis.sh' "$SET" 2>/dev/null); hooked=${hooked:-0}
      ckt "hooks registered ($hooked/8 events)" test "$hooked" -ge 8
    else
      ck 1 "settings.json exists"
    fi
    echo "  ---- platform: ${JV_OS:-unknown} ----"
    sayb=$(jv_backend_say); playb=$(jv_backend_play)
    case "$sayb"  in NONE*) ck 1 "speech:  $sayb" ;; *) ck 0 "speech:  $sayb" ;; esac
    case "$playb" in NONE*) ck 1 "audio:   $playb" ;; *) ck 0 "audio:   $playb" ;; esac
    echo "  ok    banner:  $(jv_backend_notify)"

    # The tones are generated at install time rather than shipped, so a partial or
    # interrupted install leaves motifs that reference files which do not exist —
    # and a missing tone is silent and reports nothing.
    if [ -f "$J/tones/motifs.sh" ]; then
      . "$J/tones/motifs.sh"
      missing=0; total=0
      for k in boot 'done' approve nag err idle tick sub bye; do
        for o in 1 2 3 4; do
          v="MOTIF_${k}_${o}"; seq="${!v-}"
          for item in $seq; do
            total=$((total+1))
            [ -f "$J/tones/${item%%:*}" ] || missing=$((missing+1))
          done
        done
      done
      ckt "tones: $((total-missing))/$total notes present" test "$missing" = 0
    else
      ck 1 "tones: none generated — run: node scripts/orchestrator.mjs voice --apply"
    fi

    if [ -n "${JARVIS_VOICES:-}" ]; then
      adv "JARVIS_VOICES is set, so each session speaks in a different voice."
      echo "          Four voices read as four different people, which is harder to follow"
      echo "          than one assistant naming the session it is talking about. Clear it"
      echo "          in config.sh unless you specifically want per-session speakers."
      ( export JARVIS_LIB=1; . "$J/speaker.sh"
        i=1; while [ "$i" -le 4 ]; do
          v="JV_V$i"; got="${!v-}"
          want=$(printf '%s' "$JARVIS_VOICES" | cut -d'|' -f"$i")
          [ -z "$want" ] && want="(wraps)"
          if [ -n "$got" ] && [ "$got" = "$want" ]; then echo "  ok    session $i voice: $got"
          elif [ -n "$got" ]; then echo "  note  session $i voice: $got  (wanted \"$want\", not installed)"
          else echo "  FAIL  session $i voice: unresolved"; fi
          i=$(( i + 1 ))
        done )
    fi

    # Voice QUALITY, which matters more than any other setting here. A compact voice
    # sounds mechanical however well the rest is tuned.
    hq=$(jv_hq_voices | head -5)
    if [ -n "$hq" ]; then
      echo "  ok    high-quality voices installed:"
      printf '%s\n' "$hq" | sed 's/^/          /'
      case "${JARVIS_VOICE:-}" in
        *Enhanced*|*Premium*|Siri*|*Natural*|system) ;;
        *) echo "  note  but JARVIS_VOICE is \"${JARVIS_VOICE:-unset}\", which is not one of them."
           echo "        Set it to one of the above in ~/.claude/jarvis/config.sh." ;;
      esac
    elif [ "${JV_OS:-}" = macos ]; then
      adv "no Enhanced, Premium or Siri voice is installed — this is why it sounds robotic"
      echo "        Every voice macOS ships by default is the \"compact\" set: a 2005-era"
      echo "        synthesiser. The good ones are FREE, and about three times more natural."
      echo
      echo "        Run:   jarvisctl voices --setup"
      echo "        or:    System Settings > Accessibility > Spoken Content >"
      echo "               System Voice > Manage Voices, and download a Siri or"
      echo "               Premium English (UK) voice (100-500MB each)."
      echo
      echo "        Siri voices cannot be chosen with a name — set the downloaded voice as"
      echo "        your System Voice, then put JARVIS_VOICE=\"system\" in config.sh."
    fi

    if [ "${JV_OS:-}" = macos ]; then
      V="${JARVIS_VOICE:-Daniel}"
      if [ "$V" = system ]; then
        ck 0 "voice: the System Voice (which is how Siri voices are reached)"
      elif voice_exists "$V"; then
        ck 0 "voice \"$V\" is installed"
      else
        ck 1 "voice \"$V\" is NOT installed — say falls back to the US default, silently"
        echo "        try: jarvisctl voices"
      fi
    fi
    if p=$(running); then ck 0 "speaker running (pid $p)"; else ck 0 "speaker idle (starts on demand)"; fi
    # The lock's whole purpose. If two ever started, the mutex is broken and
    # parallel sessions will talk over each other again.
    m=$(max_concurrent); b=$(births)
    if [ "${m:-0}" -le 1 ]; then ck 0 "lock holding — never more than 1 daemon at once (across $b start${b:+s})"
    else ck 1 "$m daemons were alive simultaneously — the lock is NOT holding; report this"; fi
    echo
    if [ "$fail" = 0 ]; then
      if [ "$advice" = 0 ]; then
        echo "Healthy. New sessions will speak; already-open ones need a restart."
      else
        echo "Healthy — the install is correct and it will speak."
        echo "But $advice thing(s) above are worth doing before you judge how it sounds."
      fi
    else
      echo "$fail problem(s). Re-run: node scripts/orchestrator.mjs voice --apply --force"
    fi
    [ "$fail" = 0 ] && exit 0 || exit 1
    ;;

  report)
    # A spoken situation report, on demand. The announcements tell you what just
    # CHANGED; this tells you where everything stands, which is the question you
    # actually have after twenty minutes away from the desk.
    export JARVIS_LIB=1
    . "$J/speaker.sh"
    now=$(date +%s)
    n=$(ls "$S/active" 2>/dev/null | wc -l | tr -d ' ')
    blocked=""; working=""; idle=""
    join() { [ -z "$1" ] && printf '%s' "$2" || printf '%s, %s' "$1" "$2"; }
    for f in "$S"/active/*; do
      [ -e "$f" ] || continue
      k=$(basename "$f"); IFS='|' read -r nm ord < "$f"
      who=$(spoken "$nm")
      st=$(cat "$S/start/$k" 2>/dev/null)
      if [ -r "$S/pending/$k" ]; then
        # shellcheck disable=SC2034  # the trailing fields must be read or they merge
        IFS='|' read -r pts pnm pn pe < "$S/pending/$k"
        blocked=$(join "$blocked" "$who, blocked for $(dur $(( now - ${pts:-now} )))")
      elif [ -n "$st" ]; then
        working=$(join "$working" "$who, $(dur $(( now - st )))")
      else
        idle=$(join "$idle" "$who")
      fi
    done
    case "$n" in
      0) msg="Nothing running$SIR." ;;
      1) msg="One session$SIR." ;;
      *) msg="$n sessions$SIR." ;;
    esac
    # Blocked first, always. A report that buries the stopped session behind two
    # working ones has reported everything and communicated nothing.
    [ -n "$blocked" ] && msg="$msg Blocked: $blocked."
    [ -n "$working" ] && msg="$msg Working: $working."
    [ -n "$idle" ]    && msg="$msg Idle: $idle."
    msg=$(printf '%s' "$msg" | tr -s ' ')
    echo "$msg"
    [ "${2:-}" = "--text" ] || jv_say "$msg" ;;

  log)
    tail -"${2:-25}" "$J/log" 2>/dev/null || echo "nothing announced yet" ;;

  demo)
    # The full simulation: four parallel sessions, every alert, in order, narrated.
    exec "$J/demo.sh" ;;

  chimes)
    # Audition every motif back to back, then the same motif across all four session
    # pitches. Judging these one at a time as real events arrive is hopeless — they
    # are minutes apart. Heard in sequence, a muddy or indistinct one is obvious.
    export JARVIS_LIB=1
    . "$J/speaker.sh"
    echo "Each motif once, at session pitch 1:"
    for k in boot 'done' approve nag err idle tick sub bye; do
      printf '  %-9s ' "$k"
      case "$k" in
        boot)    echo "rising arpeggio — powering up" ;;
        'done')    echo "rising fourth — resolved, positive" ;;
        approve) echo "three insistent taps — needs you" ;;
        nag)     echo "the same, tighter and higher — still waiting" ;;
        err)     echo "falling fifth on a dark atom — bad news" ;;
        idle)    echo "two soft taps — waiting, not urgent" ;;
        tick)    echo "one quiet tap — a whole short turn" ;;
        sub)     echo "quieter and lower — background specialist" ;;
        bye)     echo "falling arpeggio — powering down" ;;
      esac
      motif "$k" 1; sleep 1.1
    done
    echo
    echo "The completion motif at each of the four session pitches."
    echo "You should be able to tell them apart; they are 2 semitones apart."
    for o in 1 2 3 4; do printf '  session %s\n' "$o"; motif 'done' "$o"; sleep 1.1; done
    echo
    echo "Now the same four, interleaved, as parallel sessions would arrive:"
    for o in 1 3 2 4 1 4; do motif 'done' "$o"; sleep 0.75; done
    echo
    echo "If any of these sound muddy, indistinct or wrong, say which — the motif"
    echo "tables are at the top of ~/.claude/jarvis/speaker.sh." ;;

  mute)   m=${2:-15}; echo $(( now + m*60 )) > "$S/muted"; echo "Muted for ${m}m." ;;
  unmute) rm -f "$S/muted"; echo "Unmuted." ;;

  reset)
    # notes/ must be in both lists. It was in neither, so a reset left the previous
    # turn's spoken clauses on disk and the next completion announced them — the exact
    # staleness the begin-hook cleanup exists to prevent.
    rm -rf "$J/queue" "$S/active" "$S/start" "$S/pending" "$S/subs" "$S/notes" "$S/day" \
           "$J/run/lock" "$J/log" "$J/run/daemons.log" "$J/run/farewell"
    mkdir -p "$J/queue" "$S/active" "$S/start" "$S/pending" "$S/subs" "$S/notes"
    echo "State cleared. Any live daemon stands down within a second." ;;

  test)
    echo "Walking every alert. Listen for: distinct chimes, no overlap, one voice."
    for m in start permission idle subagent error; do
      echo "  -> $m"; "$J/jarvis.sh" "$m" </dev/null; sleep 5
    done
    echo "  -> done (simulated 4 minute turn, 6 specialists)"
    k="ctl-test"
    printf 'jarvisctl-test|1\n' > "$S/active/$k"
    echo $(( now - 240 )) > "$S/start/$k"
    echo 6 > "$S/subs/$k"
    JARVIS_SESSION_KEY="$k" JARVIS_SESSION_NAME="jarvisctl-test" "$J/jarvis.sh" 'done' </dev/null
    sleep 6; rm -f "$S/active/$k"
    echo "Done. If anything overlapped, that is a bug — report it." ;;

  voices)
    case "${JV_OS:-}" in
      macos)
        if [ "${2:-}" = "--setup" ]; then
          echo "Opening System Settings at the voice downloads."
          echo
          echo "  1. Manage Voices…  (the button under System Voice)"
          echo "  2. Download a Siri or Premium voice under English (UK) — 100-500MB."
          echo "     Siri voices are the most natural; Premium is next."
          echo "  3. Set it as your System Voice."
          echo "  4. Then, in ~/.claude/jarvis/config.sh:"
          echo "         JARVIS_VOICE=\"system\""
          echo "     A Siri voice cannot be selected by name — \"system\" tells JARVIS to"
          echo "     omit the -v flag, which is what makes `say` use it."
          echo
          open "x-apple.systempreferences:com.apple.preference.universalaccess?SpokenContent" 2>/dev/null \
            || open "x-apple.systempreferences:com.apple.Accessibility-Settings.extension?SpokenContent" 2>/dev/null \
            || echo "  (could not open Settings — navigate there manually)"
          exit 0
        fi
        hq=$(jv_hq_voices)
        if [ -n "$hq" ]; then
          echo "High-quality voices installed — use one of these:"
          printf '%s\n' "$hq" | sed 's/^/  /'
          echo
        else
          echo "NO high-quality voice is installed. Everything below is the \"compact\" set,"
          echo "which is a 2005-era synthesiser — that is why it sounds mechanical."
          echo "The good ones are free:   jarvisctl voices --setup"
          echo
        fi
        echo "Installed en_GB / en_AU voices:"
        say -v '?' 2>/dev/null | grep -E 'en_GB|en_AU' || echo "  none found"
        echo
        echo "For a voice that does not sound synthetic, download an Enhanced one:"
        echo "  System Settings > Accessibility > Spoken Content > System Voice > Manage Voices"
        echo "  then set JARVIS_VOICE in ~/.claude/jarvis/config.sh"
        echo
        for v in Daniel Oliver Serena Karen "Daniel (Enhanced)"; do
          voice_exists "$v" || continue
          echo "  $v"; JARVIS_VOICE="$v" jv_say "Task complete, sir. Awaiting your review."
          sleep 0.4
        done ;;
      windows)
        echo "Voices installed for System.Speech:"
        [ -n "${JV_PS:-}" ] && "$JV_PS" -NoProfile -Command \
          "Add-Type -AssemblyName System.Speech; (New-Object System.Speech.Synthesis.SpeechSynthesizer).GetInstalledVoices() | ForEach-Object { '  ' + \$_.VoiceInfo.Name + '  (' + \$_.VoiceInfo.Culture + ')' }" 2>/dev/null
        echo
        echo "Set JARVIS_VOICE in ~/.claude/jarvis/config.sh to one of the names above."
        echo "\"Microsoft George Desktop\" and \"Microsoft Hazel Desktop\" are the British ones."
        echo "More: Settings > Time & Language > Speech > Manage voices." ;;
      linux)
        echo "Speech backend: $(jv_backend_say)"
        if command -v espeak-ng >/dev/null 2>&1; then
          echo "Voices (set JARVIS_VOICE_LINUX in config.sh):"
          espeak-ng --voices=en 2>/dev/null | awk 'NR>1{print "  " $2 "  " $4}' | head -20
        elif command -v spd-say >/dev/null 2>&1; then
          echo "Modules:"; spd-say -O 2>/dev/null | sed 's/^/  /'
        else
          echo
          echo "No speech engine found. Install one:"
          echo "  Debian/Ubuntu: sudo apt install espeak-ng     (or speech-dispatcher)"
          echo "  Fedora:        sudo dnf install espeak-ng"
          echo "  Arch:          sudo pacman -S espeak-ng"
        fi
        command -v paplay >/dev/null 2>&1 || command -v aplay >/dev/null 2>&1 || {
          echo
          echo "No audio player found. Install one:"
          echo "  Debian/Ubuntu: sudo apt install pulseaudio-utils   (or alsa-utils)"; } ;;
      *) echo "Unsupported platform: $(uname -s)" ;;
    esac ;;

  *) echo "usage: jarvisctl [status|doctor|report|test|chimes|demo|log [n]|mute <min>|unmute|reset|voices]"; exit 2 ;;
esac
