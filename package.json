{
  "name": "orchestrator-agent-for-erp",
  "version": "1.0.0",
  "description": "Agent-swarm orchestration for Claude Code, tuned for Frappe/ERPNext development: registry-driven routing, dependency-aware execution plans, and gates that survive long sessions.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/orchestrator.mjs build",
    "health": "node scripts/orchestrator.mjs health",
    "route": "node scripts/orchestrator.mjs route",
    "plan": "node scripts/orchestrator.mjs plan",
    "pack": "node scripts/orchestrator.mjs pack",
    "doctor": "node scripts/orchestrator.mjs doctor",
    "install:skills": "node scripts/orchestrator.mjs install",
    "install:voice": "node scripts/orchestrator.mjs voice",
    "test": "node --test tests/",
    "test:voice": "tests/voice-concurrency.sh",
    "test:all": "node --test tests/ && tests/voice-concurrency.sh"
  },
  "comment": "No dependencies, deliberately. A tool that verifies a skill ecosystem should not require an npm install before it can run a security check.",
  "keywords": [
    "claude-code",
    "erpnext",
    "frappe",
    "hooks",
    "notifications",
    "orchestration",
    "skills",
    "tts",
    "voice"
  ]
}
